---
import Icon from "../icons/Icon.astro";
import "./GalleryLightbox.css";
---

<div
  id="gallery-lightbox"
  class="gallery-lightbox"
  role="dialog"
  aria-labelledby="lightbox-title"
  aria-modal="true"
  style="display: none;"
>
  <div class="gallery-lightbox__content" id="gallery-lightbox-content">
    <h2 id="lightbox-title" class="sr-only">Image Lightbox</h2>
    <button class="gallery-lightbox__close" type="button" aria-label="Close lightbox">
      <Icon name="close" size={24} />
    </button>
    
    <div class="gallery-lightbox__media" id="gallery-lightbox-media">
      <!-- Image injected dynamically -->
    </div>
    
    <div class="gallery-lightbox__caption" id="gallery-lightbox-caption">
      <!-- Caption injected dynamically -->
    </div>
    
    <div class="gallery-lightbox__controls">
      <button class="gallery-lightbox__arrow gallery-lightbox__arrow--prev" type="button" aria-label="Previous image">
        <Icon name="arrowRight" size={24} />
      </button>
      <button class="gallery-lightbox__arrow gallery-lightbox__arrow--next" type="button" aria-label="Next image">
        <Icon name="arrowRight" size={24} />
      </button>
    </div>
  </div>
</div>
